{
  "name": "roleproof",
  "version": "0.1.0",
  "description": "Dependency-free symbolic access-policy analysis with independently verified escalation witnesses.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "bin": {
    "roleproof": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/api.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "src",
    "tools",
    "web",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build-site.mjs",
    "test": "node --test",
    "check": "npm test && npm audit --omit=dev",
    "prepack": "npm run build"
  }
}
