{
  "name": "roleproof",
  "version": "0.1.0",
  "description": "Dependency-free symbolic access-policy analysis with independently verified escalation witnesses.",
  "keywords": [
    "authorization",
    "explainable-ai",
    "iam",
    "policy-analysis",
    "rbac",
    "security",
    "symbolic-ai"
  ],
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omar07ibrahim/roleproof.git"
  },
  "bugs": {
    "url": "https://github.com/omar07ibrahim/roleproof/issues"
  },
  "homepage": "https://github.com/omar07ibrahim/roleproof#readme",
  "bin": {
    "roleproof": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/api.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "files": [
    "dist",
    "examples",
    "src",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build-site.mjs",
    "test": "node --test",
    "check": "npm test && npm audit --omit=dev",
    "prepack": "npm run build"
  }
}
